# Umgebungsvariablen des Portals — Vorlage.
#
# `cp .env.example .env`, dann die Pflichtwerte eintragen. Die README verwies
# schon länger auf diese Datei; es gab sie nur nicht, und welche Schalter es
# überhaupt gibt, stand nirgends. Beim Nachsehen, warum der KI-Assistent nicht
# erscheint, ist das aufgefallen.
#
# In der Produktion stehen dieselben Werte in den Vercel-Projekteinstellungen,
# je Deployment eigene (B&W-Tür und wegportal24 sind zwei Projekte).

# ── Pflicht ────────────────────────────────────────────────────────────────
# Ohne diese beiden startet nichts.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/portal"
# Schlüssel für die Sitzungs-Cookies. Lang und zufällig:
#   openssl rand -hex 32
SESSION_SECRET=""

# ── Bereitstellungs-Variante ───────────────────────────────────────────────
# "weg" = wegportal24 (öffentliche Registrierung, Marke wegportal24),
# alles andere = B&W-Tür. Steuert Registrierung, Startseite, Titel, Logo,
# Favicon und Web-Manifest (siehe lib/app-mode.ts).
APP_MODE="verwaltung"

# ── KI-Assistent ───────────────────────────────────────────────────────────
# Die schwebende Sprechblase unten rechts erscheint NUR, wenn der Schalter
# exakt auf "true" steht UND ein Google-Zugang konfiguriert ist — entweder
# Vertex AI (unten) oder ein GEMINI_API_KEY. Fehlt beides, wird das Widget
# kommentarlos nicht gerendert (lib/assistant.ts → isAssistantEnabled).
# Zusätzlich sehen ihn nur Verwalter und Eigentümer, nicht Mieter.
AI_ASSISTANT_ENABLED="false"
GEMINI_API_KEY=""
# Optional, Vorgabe "gemini-2.0-flash".
GEMINI_MODEL=""

# ── Vertex AI (empfohlener Weg, EU-Datenverarbeitung) ──────────────────────
# Statt der Developer API kann derselbe Assistent über Vertex AI mit festem
# Regionalendpunkt laufen — Verarbeitung dann in Frankfurt, demselben Standort
# wie die Datenbank (KI-Berater-Konzept, Abschnitt 3.1). Ist ein Service-Konto
# gesetzt, gewinnt Vertex gegenüber GEMINI_API_KEY.
# Inhalt: die komplette JSON-Schlüsseldatei des Google-Service-Kontos
# (IAM → Dienstkonten → Schlüssel erstellen), als EINE Zeile.
VERTEX_SERVICE_ACCOUNT_JSON=""
# Region, Vorgabe "europe-west3" (Frankfurt). "global" ist gesperrt — der
# globale Endpunkt bietet keine Data-Residency-Zusage.
VERTEX_LOCATION=""
# Nur nötig, wenn das Abrechnungsprojekt vom project_id der Schlüsseldatei
# abweicht.
VERTEX_PROJECT_ID=""
# Embedding-Modell für den Wissensindex, Vorgabe "gemini-embedding-001".
GEMINI_EMBEDDING_MODEL=""

# Weitere KI-Funktionen, unabhängig voneinander schaltbar — beide brauchen
# ebenfalls GEMINI_API_KEY.
# Vorsortierung eingehender Vorgänge (lib/ai.ts):
AI_TRIAGE_ENABLED="false"
# Objektdaten aus hochgeladenen Unterlagen lesen:
AI_OBJEKT_IMPORT_ENABLED="false"

# ── E-Mail-Versand ─────────────────────────────────────────────────────────
# Ohne SMTP versendet das Portal nichts — Einladungen und Benachrichtigungen
# laufen dann ins Leere.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Absenderadresse; ohne Angabe aus dem Branding abgeleitet.
MAIL_FROM=""
# Basis für absolute Links in E-Mails (z. B. "https://wegportal24.de").
# Leer = aus der Anfrage abgeleitet; in Hintergrundläufen ohne Anfrage nötig.
PORTAL_BASE_URL=""

# ── Dateiablage ────────────────────────────────────────────────────────────
# Lokal ein Verzeichnis, in der Produktion Vercel Blob. Ist der Blob-Token
# gesetzt, gewinnt er.
UPLOAD_DIR="./uploads"
BLOB_READ_WRITE_TOKEN=""

# ── Mandanten und Betreiber ────────────────────────────────────────────────
# Wildcard-Domain für Mandanten-Subdomains (leer = Single-Tenant).
TENANT_BASE_DOMAIN=""
# Kommagetrennte Adressen mit Zugang zum Plattform-Bereich.
PLATFORM_ADMIN_EMAILS=""
# Schlüssel für gespeicherte Integrations-Zugangsdaten. Ohne Angabe greift
# SESSION_SECRET — für die Produktion einen eigenen setzen.
INTEGRATION_ENC_KEY=""
# Gemeinsames Geheimnis der Cron-Endpunkte (Vercel setzt es selbst).
CRON_SECRET=""

# ── Push-Benachrichtigungen (Web Push, VAPID) ──────────────────────────────
# Schlüsselpaar erzeugen: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@example.de"

# ── Optionale Anbindungen ──────────────────────────────────────────────────
# Abrechnung über Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
# Optional: Preis-ID der Stellplatz-Position (1 €/Monat je Stellplatz, flach).
# Ohne sie wird der Preis inline aus preise-daten erzeugt — wie bei den Tarifen.
STRIPE_PRICE_STELLPLATZ=""
# Dokument-Quellen aus Google Drive (Dienstkonto als JSON in einer Zeile).
GDRIVE_SERVICE_ACCOUNT_JSON=""
# Messdienst-Schnittstelle.
IMMOWARE24_API_URL=""
IMMOWARE24_API_KEY=""
# Eingehende E-Mails (nur B&W-Tür).
INBOUND_EMAIL_SECRET=""
