generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VERWALTER
  EIGENTUEMER
  MIETER
  HANDWERKER // Ausbaustufe 3
}

enum TicketType {
  SCHADEN
  ANFRAGE
  DOKUMENT_ANFRAGE
  SONSTIGES
}

enum TicketStatus {
  NEU
  IN_BEARBEITUNG
  BEAUFTRAGT
  ERLEDIGT
  GESCHLOSSEN
}

enum TicketPriority {
  NIEDRIG
  NORMAL
  HOCH
  DRINGEND
}

enum DocumentCategory {
  ABRECHNUNG
  PROTOKOLL
  VERTRAG
  BESCHEINIGUNG
  SONSTIGES
}

enum Audience {
  MIETER
  EIGENTUEMER
  ALLE
}

// Gewerk eines Handwerkers / Kategorie eines Schadens
enum Trade {
  SANITAER
  HEIZUNG
  ELEKTRO
  DACH
  MALER
  BODENLEGER
  FENSTER_TUEREN
  SCHLOSSEREI
  GARTEN
  REINIGUNG
  SCHAEDLINGSBEKAEMPFUNG
  AUFZUG
  ALLGEMEIN
  SONSTIGES
}

// Bevorzugter Kontaktweg
enum ContactMethod {
  EMAIL
  TELEFON
  MOBIL
  POST
}

// Zählerart
enum MeterType {
  STROM
  GAS
  WASSER_KALT
  WASSER_WARM
  HEIZUNG
  SONSTIGES
}

// Wartungsintervall
enum MaintenanceInterval {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
  ZWEIJAEHRLICH
  EINMALIG
}

// Status eines (Umlauf-)Beschlusses
enum ResolutionStatus {
  OFFEN
  ANGENOMMEN
  ABGELEHNT
  ZURUECKGEZOGEN
}

enum VoteChoice {
  JA
  NEIN
  ENTHALTUNG
}

// Verwaltungsart eines Objekts
enum ManagementType {
  MIETVERWALTUNG
  WEG
}

model User {
  id                  String          @id @default(cuid())
  email               String?         @unique
  username            String?         @unique
  passwordHash        String
  name                String
  phone               String?
  role                Role
  active              Boolean         @default(true)
  mustChangePassword  Boolean         @default(false)
  preferredContact    ContactMethod?  // bevorzugter Kontaktweg (Mieter/Eigentümer)
  createdAt           DateTime        @default(now())
  passwordResetToken  String?         @unique
  passwordResetExpiry DateTime?
  tenancies           Tenancy[]
  ownerships          Ownership[]
  ticketsCreated      Ticket[]        @relation("TicketCreatedBy")
  ticketsAssigned     Ticket[]        @relation("TicketAssignedTo")
  comments            TicketComment[]
  documents           Document[]
  announcements       Announcement[]
  acknowledgements    Acknowledgement[]
  conversationParts   ConversationParticipant[]
  messagesSent        Message[]
  meterReadings       MeterReading[]
  resolutionsCreated  Resolution[]     @relation("ResolutionCreatedBy")
  resolutionVotes     ResolutionVote[]
  pushSubscriptions   PushSubscription[]
}

model Property {
  id           String         @id @default(cuid())
  name         String
  street       String
  zip          String
  city         String
  managementType ManagementType @default(MIETVERWALTUNG)
  // Optionale Stammdaten zum Objekt
  buildYear    Int? // Baujahr
  livingArea   Float? // Gesamtwohnfläche in m²
  floors       Int? // Anzahl Etagen
  buildingType String? // Bauart, z. B. Mehrfamilienhaus, Massivbau
  heatingType  String? // Heizungsart, z. B. Gas-Zentralheizung
  notes        String? // freie Notizen
  // Referenz für den späteren Stammdaten-Sync mit Immoware24
  immoware24Id String?        @unique
  createdAt    DateTime       @default(now())
  units        Unit[]
  ownerships   Ownership[]
  tickets      Ticket[]
  documents    Document[]
  announcements Announcement[]
  maintenanceTasks MaintenanceTask[]
  resolutions  Resolution[]
  meters       Meter[]
}

model Unit {
  id         String     @id @default(cuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String // z. B. "WE 03, 1. OG links"
  floor      String?
  tenancies  Tenancy[]
  tickets    Ticket[]
  documents  Document[]
  meters     Meter[]
}

// Zähler – entweder einer Einheit (unitId) oder dem Objekt allgemein (propertyId)
model Meter {
  id          String         @id @default(cuid())
  unitId      String?
  unit        Unit?          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  propertyId  String? // Allgemeinzähler (Allgemeinstrom, Hauswasser …)
  property    Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        MeterType
  meterNumber String? // Zählernummer
  location    String? // Einbauort
  createdAt   DateTime       @default(now())
  readings    MeterReading[]
}

model MeterReading {
  id          String   @id @default(cuid())
  meterId     String
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  value       Float
  readingDate DateTime @default(now())
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Ownership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Tenancy {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  active    Boolean   @default(true)

  @@unique([userId, unitId])
}

model Ticket {
  id           String          @id @default(cuid())
  number       Int             @unique @default(autoincrement())
  type         TicketType
  status       TicketStatus    @default(NEU)
  priority     TicketPriority  @default(NORMAL)
  category     String? // z. B. "Wasserschaden", "Heizung" — Basis für spätere Automatisierung
  title        String
  description  String
  location     String? // Ort im Objekt, z. B. "Bad, Decke"
  propertyId   String
  property     Property        @relation(fields: [propertyId], references: [id])
  unitId       String?
  unit         Unit?           @relation(fields: [unitId], references: [id])
  trade           Trade? // Gewerk – Basis für die Handwerker-Zuordnung
  appointmentNote String? // vom Handwerker mitgeteilter Terminvorschlag
  createdById  String
  createdBy    User            @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?           @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  craftsmanId  String?
  craftsman    Craftsman?      @relation(fields: [craftsmanId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  comments     TicketComment[]
  attachments  Attachment[]
}

// Handwerker als Stammdaten (Kontaktbuch) – ohne eigenen Portal-Login
model Craftsman {
  id               String        @id @default(cuid())
  company          String? // Firma
  name             String // Ansprechpartner
  trade            Trade
  email            String?
  phone            String?
  preferredContact ContactMethod @default(TELEFON)
  notes            String?
  active           Boolean       @default(true)
  // Magic-Link-Token für das schlanke Handwerker-Portal (ohne Passwort)
  accessToken      String?       @unique
  createdAt        DateTime      @default(now())
  tickets          Ticket[]
  comments         TicketComment[]   @relation("CraftsmanComments")
  maintenanceTasks MaintenanceTask[]
}

// Wartungs-/Prüfaufgaben mit Fälligkeit (visuelle Erinnerung)
model MaintenanceTask {
  id          String              @id @default(cuid())
  title       String
  description String?
  interval    MaintenanceInterval
  dueDate     DateTime
  lastDoneAt  DateTime?
  active      Boolean             @default(true)
  propertyId  String?
  property    Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  craftsmanId String?
  craftsman   Craftsman?          @relation(fields: [craftsmanId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
}

model TicketComment {
  id                String       @id @default(cuid())
  ticketId          String
  ticket            Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Autor ist entweder ein Portal-Nutzer ODER ein Handwerker (Magic-Link)
  authorId          String?
  author            User?        @relation(fields: [authorId], references: [id])
  craftsmanAuthorId String?
  craftsmanAuthor   Craftsman?   @relation("CraftsmanComments", fields: [craftsmanAuthorId], references: [id])
  body              String
  // interne Notizen sind nur für Verwalter sichtbar
  internal          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  attachments       Attachment[]
}

model Attachment {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  fileName   String
  storedName String         @unique
  mimeType   String
  size       Int
  createdAt  DateTime       @default(now())
}

model Document {
  id           String           @id @default(cuid())
  title        String
  category     DocumentCategory
  audience     Audience
  fileName     String
  storedName   String           @unique
  mimeType     String
  size         Int
  propertyId   String?
  property     Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())
  acknowledgements Acknowledgement[]
}

model Announcement {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  audience    Audience @default(ALLE)
  title       String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  acknowledgements Acknowledgement[]
}

// Lesebestätigung ("zur Kenntnis genommen") für Dokumente und Aushänge
model Acknowledgement {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userId, documentId])
  @@unique([userId, announcementId])
}

// Direktnachrichten zwischen Verwalter und Mieter/Eigentümer
model Conversation {
  id           String                    @id @default(cuid())
  subject      String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
}

// WEG-Umlaufbeschluss mit digitaler Abstimmung
model Resolution {
  id          String           @id @default(cuid())
  propertyId  String
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number      Int? // laufende Nummer in der Beschlusssammlung (nach Entscheidung)
  title       String
  description String
  status      ResolutionStatus @default(OFFEN)
  deadline    DateTime?
  createdById String
  createdBy   User             @relation("ResolutionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?
  votes       ResolutionVote[]
}

model ResolutionVote {
  id           String     @id @default(cuid())
  resolutionId String
  resolution   Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice       VoteChoice
  comment      String?
  createdAt    DateTime   @default(now())

  @@unique([resolutionId, userId])
}

// Web-Push-Abonnements (PWA-Benachrichtigungen)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
