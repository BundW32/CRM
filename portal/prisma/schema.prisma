generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VERWALTER
  EIGENTUEMER
  MIETER
  HANDWERKER // Ausbaustufe 3
}

enum TicketType {
  SCHADEN
  ANFRAGE
  DOKUMENT_ANFRAGE
  SONSTIGES
}

enum TicketStatus {
  NEU
  IN_BEARBEITUNG
  BEAUFTRAGT
  ERLEDIGT
  GESCHLOSSEN
}

enum TicketPriority {
  NIEDRIG
  NORMAL
  HOCH
  DRINGEND
}

enum DocumentCategory {
  ABRECHNUNG
  PROTOKOLL
  VERTRAG
  BESCHEINIGUNG
  SONSTIGES
}

enum Audience {
  MIETER
  EIGENTUEMER
  ALLE
  BEIRAT // nur Verwaltungsbeirat des Objekts
}

// Gewerk eines Handwerkers / Kategorie eines Schadens
enum Trade {
  SANITAER
  HEIZUNG
  ELEKTRO
  DACH
  MALER
  BODENLEGER
  FENSTER_TUEREN
  SCHLOSSEREI
  GARTEN
  REINIGUNG
  SCHAEDLINGSBEKAEMPFUNG
  AUFZUG
  ALLGEMEIN
  SONSTIGES
}

// Bevorzugter Kontaktweg
enum ContactMethod {
  EMAIL
  TELEFON
  MOBIL
  POST
}

// Art eines Kontakteintrags im Adressbuch. Handwerker sind der historische Fall
// (daher Vorgabe); die übrigen Kategorien machen das Kontaktbuch zum echten
// Adressbuch – Ableseservice, Wasserversorger, Stadt/Behörde, Steuerberater …
// Alle Arten bleiben beauftragbar: ein Messdienst bekommt denselben Auftrags-
// Link wie ein Handwerker. Weitere Werte lassen sich jederzeit ergänzen
// (in Postgres ist das Hinzufügen eines Enum-Werts unproblematisch).
enum ContactKind {
  HANDWERKER
  DIENSTLEISTER
  VERSORGER
  BEHOERDE
  SONSTIGES
}

// Zählerart
enum MeterType {
  STROM
  GAS
  WASSER_KALT
  WASSER_WARM
  HEIZUNG
  SONSTIGES
}

// Wartungsintervall
enum MaintenanceInterval {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
  ZWEIJAEHRLICH
  DREIJAEHRLICH
  EINMALIG
}

// Status eines (Umlauf-)Beschlusses
enum ResolutionStatus {
  OFFEN
  ANGENOMMEN
  ABGELEHNT
  ZURUECKGEZOGEN
}

enum VoteChoice {
  JA
  NEIN
  ENTHALTUNG
}

// Verwaltungsart eines Objekts
enum ManagementType {
  MIETVERWALTUNG
  WEG
}

// Stimmprinzip einer WEG bei Abstimmungen (§25 WEG; konkret regelt es die
// Gemeinschaftsordnung):
//   KOPF   = ein Eigentümer, eine Stimme (gesetzlicher Standard)
//   MEA    = Stimmgewicht nach Miteigentumsanteilen (Wertprinzip)
//   OBJEKT = eine Stimme je Einheit (Objektprinzip)
enum VotingPrinciple {
  KOPF
  MEA
  OBJEKT
}

// Erforderliche Mehrheit eines Beschlusses:
//   EINFACH              = Mehrheit der abgegebenen Stimmen (Standard)
//   DREIVIERTEL          = qualifizierte 3/4-Mehrheit (z. B. laut GO)
//   DOPPELT_QUALIFIZIERT = §21 II: > 2/3 der Stimmen UND > 1/2 aller MEA
//   ALLSTIMMIG           = Zustimmung aller Eigentümer (Vereinbarung)
enum MajorityType {
  EINFACH
  DREIVIERTEL
  DOPPELT_QUALIFIZIERT
  ALLSTIMMIG
}

// ── WEG-Finanzfundament ──────────────────────────────────────────────────────

// Art einer Einheit (Sondereigentum)
enum UnitType {
  WOHNUNG
  TEILEIGENTUM
  STELLPLATZ
  SONSTIGES
}

// Umlageschlüssel je Kostenart
enum DistributionKey {
  MEA
  FLAECHE
  EINHEITEN
  PERSONEN
  VERBRAUCH
  FESTBETRAG
  INDIVIDUELL
}

// Grobe Kategorie einer Kostenart
enum CostCategory {
  BETRIEBSKOSTEN
  INSTANDHALTUNG
  VERWALTUNG
  RUECKLAGENZUFUEHRUNG
  SONSTIGES
  // Einnahmen der Gemeinschaft (§ 28 Abs. 1 WEG verlangt Einnahmen UND Ausgaben):
  // Zinsen, Miete aus Gemeinschaftseigentum, PV-Einspeisung. Der Betrag bleibt
  // wie überall positiv; die Richtung steckt in der Kategorie.
  ERTRAG
}

// §35a EStG — Lohnanteil-Klassifizierung einer Kostenart
enum LaborShareType {
  KEINE
  HAUSHALTSNAHE_DIENSTLEISTUNG
  HANDWERKERLEISTUNG
}

// Kontoart – Erhaltungsrücklage strikt getrennt vom laufenden Konto
enum LedgerAccountKind {
  GIRO
  RUECKLAGE
}

// Buchungsrichtung; Betrag immer positiv, Richtung über kind
enum BookingKind {
  EINNAHME
  AUSGABE
  UMBUCHUNG
}

// Fälligkeit der monatlichen Vorschüsse (§ 28 Abs. 1 WEG). Ein freier Tag ist
// auf den 28. begrenzt, damit es den Termin in jedem Monat gibt — ein „31."
// fiele im Februar aus.
enum DueDayRule {
  MONATSERSTER
  DRITTER_WERKTAG
  FREIER_TAG
}

// Status eines Wirtschaftsplans (§ 28 Abs. 1 WEG)
enum PlanStatus {
  ENTWURF
  BESCHLOSSEN
}

// Status einer Jahresabrechnung (§ 28 Abs. 2 WEG) — FERTIG ist unveränderlich
enum StatementStatus {
  ENTWURF
  FERTIG
}

// Prüfvermerk des Verwaltungsbeirats (§ 29 Abs. 3 WEG) auf Wirtschaftsplan bzw.
// Jahresabrechnung: geprüft und für gut befunden ODER mit Anmerkungen.
enum BeiratReviewStatus {
  GEPRUEFT
  ANMERKUNGEN
}

// Herkunft eines Dokuments – manueller Upload oder automatischer Sync
enum DocumentSource {
  UPLOAD // manueller Upload (Standard)
  GDRIVE // Google Drive Sync
}

// Art eines Eigentümer-Antrags (Selbstverwaltung):
//   BESCHLUSSANTRAG = Antrag auf einen (Umlauf-)Beschluss
//   VERSAMMLUNG     = Verlangen einer (außerordentlichen) Versammlung (§24 II WEG)
enum MotionType {
  BESCHLUSSANTRAG
  VERSAMMLUNG
}

// Status eines Eigentümer-Antrags:
//   EINGEREICHT = liegt dem internen Verwalter zur Prüfung vor
//   UEBERNOMMEN = als Umlaufbeschluss oder Versammlungs-TOP übernommen
//   ABGELEHNT   = vom internen Verwalter abgelehnt (mit Begründung)
enum MotionStatus {
  EINGEREICHT
  UEBERNOMMEN
  ABGELEHNT
}

// ── Mandant (White-Label) ─────────────────────────────────────────────────────
// Oberste Mandanten-Einheit: eine Hausverwaltung. Alle mandantentragenden
// Tabellen hängen über organizationId an genau einer Organisation. Der Org-Filter
// gilt für ALLE Rollen – auch SuperAdmin (= Vollzugriff INNERHALB der eigenen Org).
// Theming-/Impressumsfelder sind für Phase 4.4 (White-Label) bereits vorbereitet.
model Organization {
  id             String   @id @default(cuid())
  slug           String   @unique // für spätere Subdomain/Custom-Domain (z. B. "bw")
  name           String // Anzeigename der Hausverwaltung
  legalName      String? // vollständiger Firmenname (Impressum)
  accountType    String   @default("verwaltung") // verwaltung | selbstverwalter
  // White-Label-Theming (Phase 4.4)
  logoStoredName String?
  primaryColor   String? // z. B. "#E8740C"
  // Kontakt / Impressum
  email          String?
  phone          String?
  website        String? // z. B. "www.beispiel.de" (E-Mail-/Dokument-Fußzeile)
  street         String?
  zip            String?
  city           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Billing / Abonnement (Phase 5 – Gerüst; Preismodell folgt)
  plan                 String    @default("free") // free | pro | …
  subscriptionStatus   String    @default("trialing") // trialing | active | past_due | canceled
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialEndsAt          DateTime?

  // Rechtliches / Akquise (Phase 6 – Gerüst)
  termsAcceptedAt      DateTime? // Zeitpunkt der AGB-/AVV-Zustimmung bei Registrierung
  termsVersion         String? // Version der akzeptierten Rechtsdokumente
  termsAcceptedIp      String? // IP zum Zeitpunkt der Zustimmung (Nachweis)
  termsAcceptedUserAgent String? // User-Agent zum Zeitpunkt der Zustimmung (Nachweis)
  referralSource       String? // Herkunft der Registrierung (z. B. "hausmatch")

  // Interne Notiz des Plattform-Betreibers zu diesem Kunden (nur /plattform sichtbar)
  platformNote         String?

  users                 User[]
  properties            Property[]
  craftsmen             Craftsman[]
  tickets               Ticket[]
  documents             Document[]
  announcements         Announcement[]
  notes                 Note[]
  maintenanceTasks      MaintenanceTask[]
  conversations         Conversation[]
  resolutions           Resolution[]
  handovers             Handover[]
  documentSourceConfigs DocumentSourceConfig[]
  ownersMeetings        OwnersMeeting[]
  ownerMotions          OwnerMotion[]
  platformInvoices      PlatformInvoice[]
  costTypes             CostType[]
  ledgerAccounts        LedgerAccount[]
  bookings              Booking[]
  bankImportBatches     BankImportBatch[]
  economicPlans         EconomicPlan[]
  duePostings           DuePosting[]
  paymentAllocations    PaymentAllocation[]
  unitOwnerships        UnitOwnership[]
  annualStatements      AnnualStatement[]
  hausgeldMahnungen     HausgeldMahnung[]
  sonderumlagen         Sonderumlage[]
  maintenanceMeasures   MaintenanceMeasure[]
  integrationSettings   IntegrationSetting[]
  sepaMandates          SepaMandate[]
  co2Allocations        Co2Allocation[]
  craftsmanInvoices     CraftsmanInvoice[]
  beiratTasks           BeiratTask[]
}

model User {
  id                   String                    @id @default(cuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                String?                   @unique
  username             String?                   @unique
  passwordHash         String
  name                 String
  firstName            String? // Vorname
  lastName             String? // Nachname
  salutation           String? // "Herr" oder "Frau"
  phone                String?
  role                 Role
  active               Boolean                   @default(true)
  mustChangePassword   Boolean                   @default(false)
  // Erklärende Hinweise in der Oberfläche anzeigen. Standardmäßig AN: Wer sie
  // nicht braucht, schaltet sie ab — die umgekehrte Voreinstellung erreicht
  // genau die nicht, für die sie da sind. Eine Vorliebe der **Person**, nicht
  // der Organisation: Zwei Eigentümer derselben WEG dürfen es verschieden
  // wollen. Warnungen und Fehlermeldungen hängen NICHT daran.
  showHints            Boolean                   @default(true)
  // Wann die geführte Einrichtung durchlaufen wurde. `null` = noch nie —
  // dann erscheint sie einmal von selbst. Zurücksetzen startet sie neu.
  tourDoneAt           DateTime?
  preferredContact     ContactMethod? // bevorzugter Kontaktweg (Mieter/Eigentümer)
  // Optionale Anschrift (z. B. Eigentümer als Wohnungsgeber) und Unterschriftsbild
  street               String?
  zip                  String?
  city                 String?
  signatureStoredName  String? // hinterlegte Unterschrift (Bild) für Bescheinigungen
  // Hat die Person selbst unterschrieben (Self-Service unter „Konto")? Nur dann
  // darf die Unterschrift unter ihrem eigenen Namen erscheinen. Vom Verwalter
  // erfasste Unterschriften gelten als Fremderfassung.
  signatureSelfSigned  Boolean                   @default(false)
  // Ermächtigung des Eigentümers (§ 19 Abs. 5 BMG): erlaubt der Verwaltung,
  // Wohnungsgeberbestätigungen und Mietbescheinigungen in seinem Namen zu
  // erstellen. Gilt pro Person – greift aber nur für tatsächlich vermietete
  // Einheiten, weil ohne Mietverhältnis nichts zu bescheinigen ist.
  certMandateGrantedAt DateTime?
  certMandateRevokedAt DateTime?
  // Wie kam die Ermächtigung zustande? "SELBST" = im Portal erteilt,
  // "SCHRIFTLICH" = unterschriebene Vollmacht auf Papier, von der Verwaltung
  // vermerkt. Beim schriftlichen Weg hält `certMandateNote` die Fundstelle fest
  // (welches Dokument, wo abgelegt) und `certMandateRecordedById`, wer den
  // Vermerk gesetzt hat – ohne beides wäre der Vermerk kein Nachweis, sondern
  // nur eine Behauptung. Bewusst keine Relation: Der Vermerkende soll den
  // Nachweis auch dann noch belegen, wenn sein Konto später entfällt.
  certMandateSource    String?
  certMandateNote      String?
  certMandateRecordedById String?
  createdAt            DateTime                  @default(now())
  passwordResetToken   String?                   @unique
  passwordResetExpiry  DateTime?
  // E-Mail-Verifizierung (Phase 5 – Self-Service-Onboarding)
  emailVerifiedAt      DateTime?
  emailVerifyToken     String?                   @unique
  emailVerifyExpiry    DateTime?
  // DSGVO-Löschung durch Anonymisierung (Art. 17): markiert einen entpersonalisierten
  // Datensatz, damit er aus Kontakt-/Eigentümerlisten ausgeblendet werden kann.
  anonymizedAt         DateTime?
  tenancies            Tenancy[]
  ownerships           Ownership[]
  ticketsCreated       Ticket[]                  @relation("TicketCreatedBy")
  ticketsAssigned      Ticket[]                  @relation("TicketAssignedTo")
  comments             TicketComment[]
  documents            Document[]
  documentRecipients   DocumentRecipient[]
  announcements        Announcement[]
  acknowledgements     Acknowledgement[]
  conversationParts    ConversationParticipant[]
  messagesSent         Message[]
  meterReadings        MeterReading[]
  resolutionsCreated   Resolution[]              @relation("ResolutionCreatedBy")
  resolutionVotes      ResolutionVote[]          @relation("VoteOwner")
  resolutionVotesCast  ResolutionVote[]          @relation("VoteCastBy")
  beiratTasksCreated   BeiratTask[]              @relation("BeiratTaskCreatedBy")
  economicPlansReviewed EconomicPlan[]          @relation("EconomicPlanBeiratReview")
  statementsReviewed   AnnualStatement[]         @relation("StatementBeiratReview")
  ownersMeetingsCreated OwnersMeeting[]          @relation("MeetingCreatedBy")
  motionsSubmitted     OwnerMotion[]             @relation("MotionSubmittedBy")
  motionsDecided       OwnerMotion[]             @relation("MotionDecidedBy")
  pushSubscriptions    PushSubscription[]
  notesAuthored        Note[]
  notesAbout           Note[]                    @relation("NotesAboutUser")
  handoversCreated     Handover[]                @relation("HandoverCreatedBy")
  isSuperAdmin              Boolean                   @default(false)
  // Plattform-Betreiber (B&W) – Zugang zu /plattform. NUR per DB/Seed setzbar,
  // niemals über eine Oberfläche. Zusätzlich muss die E-Mail in der Env-Variable
  // PLATFORM_ADMIN_EMAILS stehen (doppelte Wand, siehe lib/platform.ts).
  isPlatformAdmin           Boolean                   @default(false)
  propertyAssignments       PropertyAssignment[]
  craftsmanAssignments      CraftsmanAssignment[]
  auditLogs                 AuditLog[]
  documentSourceConfigs     DocumentSourceConfig[]
  platformInvoicesCreated   PlatformInvoice[]         @relation("PlatformInvoiceCreatedBy")
  bookingsCreated           Booking[]                 @relation("BookingCreatedBy")
  bankImportsCreated        BankImportBatch[]         @relation("BankImportCreatedBy")
  economicPlansCreated      EconomicPlan[]            @relation("EconomicPlanCreatedBy")
  statementsCreated         AnnualStatement[]         @relation("StatementCreatedBy")
  unitOwnerships            UnitOwnership[]
  mahnungenCreated          HausgeldMahnung[]         @relation("MahnungCreatedBy")
  paymentAllocations        PaymentAllocation[]       @relation("PaymentAllocationCreatedBy")
  sonderumlagenCreated      Sonderumlage[]            @relation("SonderumlageCreatedBy")
  maintenanceMeasuresCreated MaintenanceMeasure[]     @relation("MaintenanceMeasureCreatedBy")
  sepaMandatesCreated        SepaMandate[]            @relation("SepaMandateCreatedBy")
  co2AllocationsCreated      Co2Allocation[]          @relation("Co2AllocationCreatedBy")
  wegSetupStepsDone          WegSetupStep[]           @relation("WegSetupStepDoneBy")

  @@index([role])
  @@index([role, active])
  @@index([organizationId])
}

model PropertyAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId])
}

// Optionale Einschränkung, welche Handwerker ein (eingeschränkter) Verwalter sieht.
// Keine Einträge = sieht alle (gemeinsamer Pool); ein oder mehr Einträge = nur diese.
model CraftsmanAssignment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  craftsmanId String
  craftsman   Craftsman @relation(fields: [craftsmanId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, craftsmanId])
  @@index([craftsmanId])
}

model Property {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  street              String
  zip                 String
  city                String
  managementType      ManagementType       @default(MIETVERWALTUNG)
  votingPrinciple     VotingPrinciple      @default(KOPF) // Stimmprinzip (nur WEG)
  // WEG-Finanzstammdaten
  meaTotal            Int? // MEA-Nenner (Summe aller Anteile, z. B. 1000)
  fiscalYearStartMonth Int                 @default(1) // Wirtschaftsjahr-Beginn (1 = Januar)
  // Wann das monatliche Hausgeld fällig wird. Steuert die Sollstellungen und
  // zugleich den Wortlaut der Beschlussvorlage — beides muss dasselbe sagen,
  // sonst mahnt die Verwaltung zu einem Termin, den der Beschluss nicht nennt.
  dueDayRule          DueDayRule           @default(MONATSERSTER)
  dueDayOfMonth       Int? // nur bei FREIER_TAG (1–28)
  // SEPA-Lastschrift: Gläubiger-Identifikationsnummer der Gemeinschaft (Bundesbank)
  sepaCreditorId      String?
  // Standard-Link zur Video-Zuschaltung (externer Dienst, z. B. Jitsi/Zoom) —
  // wird beim Anlegen einer Versammlung vorbelegt, je Termin überschreibbar.
  defaultVideoLink    String?
  // Optionale Stammdaten zum Objekt
  buildYear           Int? // Baujahr
  livingArea          Float? // Gesamtwohnfläche in m²
  floors              Int? // Anzahl Etagen
  buildingType        String? // Bauart, z. B. Mehrfamilienhaus, Massivbau
  heatingType         String? // Heizungsart, z. B. Gas-Zentralheizung
  notes               String? // freie Notizen
  // Titelbild des Objekts (Blob/Data-URL wie Logo/Unterschrift). Sichtbar für
  // Verwalter im Scope sowie Eigentümer/Mieter des Objekts.
  titleImageStoredName String?
  // Referenz für den späteren Stammdaten-Sync mit Immoware24
  immoware24Id        String?              @unique
  // Archiviert = aus den aktiven Verwalter-Listen ausgeblendet (Bestandsdaten
  // bleiben erhalten). Reaktivierbar; hartes Löschen nur bei leeren Objekten.
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  units               Unit[]
  ownerships          Ownership[]
  tickets             Ticket[]
  documents           Document[]
  announcements       Announcement[]
  maintenanceTasks    MaintenanceTask[]
  resolutions         Resolution[]
  meters                Meter[]
  internalNotes         Note[]
  propertyAssignments   PropertyAssignment[]
  documentSourceConfigs DocumentSourceConfig[]
  ownersMeetings        OwnersMeeting[]
  ownerMotions          OwnerMotion[]
  costTypes             CostType[]
  ledgerAccounts        LedgerAccount[]
  bookings              Booking[]
  bankImportBatches     BankImportBatch[]
  economicPlans         EconomicPlan[]
  duePostings           DuePosting[]
  annualStatements      AnnualStatement[]
  hausgeldMahnungen     HausgeldMahnung[]
  sonderumlagen         Sonderumlage[]
  maintenanceMeasures   MaintenanceMeasure[]
  sepaMandates          SepaMandate[]
  co2Allocations        Co2Allocation[]
  beiratTasks           BeiratTask[]
  setupSteps            WegSetupStep[]

  @@index([organizationId])
}

model Unit {
  id            String     @id @default(cuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label         String // INTERNE Bezeichnung (z. B. "WE 03") – nur für Verwalter
  // EXTERNE Bezeichnung / Lage (z. B. "1. OG links") – erscheint in Dokumenten
  // und in der Mieter-/Eigentümer-Ansicht. Leer = Fallback auf die interne label.
  externalLabel String?
  floor         String?
  // WEG-Finanzstammdaten (Kostenverteilung — NICHT Ownership.mea = Stimmgewicht)
  unitType      UnitType   @default(WOHNUNG)
  mea           Int? // MEA-Zähler dieser Einheit (Nenner: Property.meaTotal)
  livingArea    Float? // Wohn-/Nutzfläche in m²
  personCount   Int? // Personenzahl (Umlageschlüssel PERSONEN)
  orderIndex    Int        @default(0)
  duePostings   DuePosting[]
  hausgeldPayments Booking[] // zugeordnete Zahlungseingänge (Hausgeld)
  unitOwnerships UnitOwnership[]
  statementUnitAmounts StatementUnitAmount[]
  hausgeldMahnungen HausgeldMahnung[]
  tenancies     Tenancy[]
  tickets       Ticket[]
  documents     Document[]
  meters        Meter[]
  internalNotes Note[]
  handovers     Handover[]
  sepaMandates  SepaMandate[]

  @@index([propertyId])
}

// Zähler – entweder einer Einheit (unitId) oder dem Objekt allgemein (propertyId)
model Meter {
  id          String         @id @default(cuid())
  unitId      String?
  unit        Unit?          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  propertyId  String? // Allgemeinzähler (Allgemeinstrom, Hauswasser …)
  property    Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        MeterType
  meterNumber String? // Zählernummer
  location    String? // Einbauort
  // Fernablesbar (funk-/smart): löst die Pflicht zur monatlichen unterjährigen
  // Verbrauchsinformation aus (§ 6a HeizkostenV).
  remoteReadable Boolean     @default(false)
  createdAt   DateTime       @default(now())
  readings    MeterReading[]

  @@index([unitId])
  @@index([propertyId])
}

model MeterReading {
  id          String   @id @default(cuid())
  meterId     String
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  value       Float
  readingDate DateTime @default(now())
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([meterId])
}

model Ownership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mea        Int? // Miteigentumsanteil (z. B. von 1000) – Stimmgewicht beim Wertprinzip
  voteUnits  Int? // Anzahl Stimmen beim Objektprinzip (Einheiten dieses Eigentümers)
  isBoardMember Boolean @default(false) // Mitglied des Verwaltungsbeirats (Selbstverwaltung)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model Tenancy {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  active    Boolean   @default(true)
  // Monatliche Betriebskosten-Vorauszahlung des Mieters (für die Abrechnung, M-K)
  bkPrepaymentMonthlyCents Int?
  // Mietvertrags-Kerndaten (Mietverwaltung). Beträge als Integer-Cent.
  rentColdCents            Int? // Kaltmiete / Grundmiete monatlich
  depositCents             Int? // Kaution
  // Optionaler Mietvertrag als Datei (Storage-Konvention wie Beleg/Handover)
  contractStoredName       String?
  contractFileName         String?
  contractMimeType         String?

  @@unique([userId, unitId])
  @@index([unitId])
  @@index([userId, active])
}

model Ticket {
  id                       String          @id @default(cuid())
  organizationId           String
  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number                   Int             @unique @default(autoincrement())
  type                     TicketType
  status                   TicketStatus    @default(NEU)
  priority                 TicketPriority  @default(NORMAL)
  category                 String? // z. B. "Wasserschaden", "Heizung" — Basis für spätere Automatisierung
  title                    String
  description              String
  location                 String? // Ort im Objekt, z. B. "Bad, Decke"
  propertyId               String?
  property                 Property?       @relation(fields: [propertyId], references: [id])
  unitId                   String?
  unit                     Unit?           @relation(fields: [unitId], references: [id])
  // Externer Absender (z. B. E-Mail), wenn (noch) kein Portal-Nutzer zugeordnet ist
  senderEmail              String?
  senderName               String?
  trade                    Trade? // Gewerk – Basis für die Handwerker-Zuordnung
  appointmentNote          String? // vom Handwerker mitgeteilter Terminvorschlag
  // Terminvorschlag wird erst wirksam, wenn der Verwalter ihn bestätigt.
  // Null = Vorschlag offen / wartet auf Bestätigung.
  appointmentConfirmedAt   DateTime?
  appointmentConfirmedById String?
  // Abschluss-Workflow: Der Handwerker MELDET die Erledigung (oft per Telefon/
  // WhatsApp/E-Mail, nicht im Portal). Erst die ausdrückliche Bestätigung durch
  // den Verwalter schließt den Vorgang. completionReportedAt = gemeldet (Status
  // ERLEDIGT, wartet auf Prüfung); closedAt = vom Verwalter bestätigt (GESCHLOSSEN).
  completionReportedAt     DateTime?
  completionReportedVia    String? // Kanal der Erledigungsmeldung (Portal, Telefon, WhatsApp, …)
  closedAt                 DateTime?
  closedById               String?
  inboundMessageId         String?         @unique // Idempotenz für E-Mail-Eingang (verhindert Doppel-Tickets)
  // SLA-Fälligkeitsdatum – wird aus der Priorität beim Erstellen berechnet;
  // bei Prioritätsänderung wird es relativ zum Änderungszeitpunkt neu gesetzt.
  dueAt                    DateTime?
  // Optionale Kostenerfassung – KEIN Buchhaltungsmodul, nur eine interne Notiz
  // (z. B. für Eigentümer-Jahresübersicht). Betrag in Cent, um Rundungsfehler zu
  // vermeiden; costNote für Anbieter/netto-brutto/KV-Nr. Buchhaltung bleibt extern.
  costCents                Int?
  costNote                 String?
  // Herkunft: Vorgang aus einer Wartungsaufgabe erzeugt (Rückverfolgung)
  sourceMaintenanceTaskId  String?
  sourceMaintenanceTask    MaintenanceTask? @relation(fields: [sourceMaintenanceTaskId], references: [id], onDelete: SetNull)
  createdById              String
  createdBy                User            @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId             String?
  assignedTo               User?           @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  craftsmanId              String?
  craftsman                Craftsman?      @relation(fields: [craftsmanId], references: [id])
  // Freigabe für die Beauftragung EXTERNER Handwerker. Null = noch nicht
  // freigegeben → externe Beauftragung ist serverseitig gesperrt (interne
  // Eigenleistung zuerst). Wird durch eine bewusste Verwalter-Aktion gesetzt.
  externalReleasedAt       DateTime?
  externalReleasedById     String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  comments                 TicketComment[]
  attachments              Attachment[]
  invoice                  CraftsmanInvoice?

  @@index([propertyId])
  @@index([unitId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([craftsmanId])
  @@index([status])
  @@index([updatedAt])
  @@index([type])
  @@index([priority])
  @@index([dueAt])
  @@index([sourceMaintenanceTaskId])
  @@index([organizationId])
}

// Handwerker als Stammdaten (Kontaktbuch) – ohne eigenen Portal-Login
model Craftsman {
  id                   String                @id @default(cuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company              String? // Firma
  name                 String // Ansprechpartner
  // Art des Eintrags im Adressbuch (Handwerker, Versorger, Behörde …).
  kind                 ContactKind           @default(HANDWERKER)
  // Gewerk – nur für Handwerker aussagekräftig; andere Arten nutzen ALLGEMEIN.
  trade                Trade
  email                String?
  phone                String?
  preferredContact     ContactMethod         @default(TELEFON)
  notes                String?
  active               Boolean               @default(true)
  // Interner Handwerker (Eigenleistung). Wird bei der Zuordnung zuerst angeboten;
  // externe Handwerker dürfen erst nach Verwalter-Freigabe beauftragt werden.
  isInternal           Boolean               @default(false)
  // Magic-Link-Token für das schlanke Handwerker-Portal (ohne Passwort)
  accessToken          String?               @unique
  // ── Bauabzugsteuer (§ 48 EStG) ────────────────────────────────────────────
  // Wer eine Bauleistung bezieht, muss 15 % des Rechnungsbetrags einbehalten
  // und ans Finanzamt abführen — es sei denn, der Leistende legt eine gültige
  // Freistellungsbescheinigung nach § 48b EStG vor. Ohne sie und ohne Einbehalt
  // haftet der Leistungsempfänger, also die Gemeinschaft (§ 48a Abs. 3 EStG).
  //
  // Das ist der Normalfall, nicht die Ausnahme: Die meisten Betriebe haben eine
  // solche Bescheinigung. Deshalb wird sie hier festgehalten — sonst warnte das
  // Programm bei jedem Handwerker und würde nach dem dritten Mal weggeklickt.
  exemptionNumber      String? // Sicherheitsnummer der Bescheinigung
  exemptionValidUntil  DateTime? // Gültig bis; danach greift der Einbehalt wieder
  // Die Bescheinigung als Datei (gleiche Storage-Konvention wie Beleg/Anhang).
  // Nummer und Datum steuern die Prüfung; das Dokument ist der Nachweis, den
  // das Finanzamt im Zweifel sehen will — eine abgetippte Nummer ist keiner.
  exemptionStoredName  String?
  exemptionFileName    String?
  exemptionMimeType    String?
  createdAt            DateTime              @default(now())
  tickets              Ticket[]
  comments             TicketComment[]       @relation("CraftsmanComments")
  maintenanceTasks     MaintenanceTask[]
  verwalterAssignments CraftsmanAssignment[]
  invoices             CraftsmanInvoice[]
  bookings             Booking[]

  @@index([active, trade])
  @@index([email])
  @@index([organizationId])
}

// Wartungs-/Prüfaufgaben mit Fälligkeit (visuelle Erinnerung)
model MaintenanceTask {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  interval         MaintenanceInterval
  dueDate          DateTime
  lastDoneAt       DateTime?
  active           Boolean             @default(true)
  propertyId       String?
  property         Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  craftsmanId      String?
  craftsman        Craftsman?          @relation(fields: [craftsmanId], references: [id], onDelete: SetNull)
  // Herkunft aus dem WEG-Prüfpflichten-Katalog (Idempotenz der Übernahme je Objekt)
  catalogKey       String?
  // Letzte per E-Mail-Adapter versendete Fälligkeits-Erinnerung (verhindert Doppelmails)
  lastReminderAt   DateTime?
  createdAt        DateTime            @default(now())
  generatedTickets Ticket[]

  @@index([propertyId])
  @@index([dueDate])
  @@index([active, dueDate])
  @@index([organizationId])
  @@index([propertyId, catalogKey])
}

model TicketComment {
  id                String       @id @default(cuid())
  ticketId          String
  ticket            Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Autor ist entweder ein Portal-Nutzer ODER ein Handwerker (Magic-Link)
  authorId          String?
  author            User?        @relation(fields: [authorId], references: [id])
  craftsmanAuthorId String?
  craftsmanAuthor   Craftsman?   @relation("CraftsmanComments", fields: [craftsmanAuthorId], references: [id])
  body              String
  // interne Notizen sind nur für Verwalter sichtbar
  internal          Boolean      @default(false)
  // Idempotenz für E-Mail-Antworten (verhindert Doppel-Kommentare bei Webhook-Wiederholungen)
  inboundMessageId  String?      @unique
  createdAt         DateTime     @default(now())
  attachments       Attachment[]

  @@index([ticketId])
}

model Attachment {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  fileName   String
  storedName String
  mimeType   String
  size       Int
  createdAt  DateTime       @default(now())

  @@index([ticketId])
  @@index([commentId])
}

model Document {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  category         DocumentCategory
  audience         Audience
  fileName         String
  storedName       String
  mimeType         String
  size             Int
  propertyId       String?
  property         Property?         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId           String?
  unit             Unit?             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User              @relation(fields: [uploadedById], references: [id])
  // Herkunft: UPLOAD = manuell, GDRIVE = automatischer Sync
  source           DocumentSource    @default(UPLOAD)
  // Externe Datei-ID (z. B. Google Drive fileId) für Deduplizierung beim Sync
  externalRef      String?
  createdAt        DateTime          @default(now())
  acknowledgements Acknowledgement[]
  // Optionale gezielte Empfänger. Sind Empfänger gesetzt, sehen NUR diese Personen
  // (plus der Verwalter im Scope) das Dokument – die Audience-/Objekt-Logik greift
  // dann nicht. Leer = wie bisher (Sichtbarkeit über audience + Objekt/Einheit).
  recipients       DocumentRecipient[]

  @@index([propertyId])
  @@index([unitId])
  @@index([externalRef])
  @@index([organizationId])
}

// Gezielter Empfänger eines Dokuments (1:1-Freigabe an eine bestimmte Person).
model DocumentRecipient {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
  @@index([userId])
}

// Konfiguration einer Dokument-Quelle (z. B. ein Google Drive Ordner).
// Jede Quelle hat einen Connector-Typ, eine optionale Objekt-Zuordnung und
// Sync-Metadaten. organizationId ist für die spätere Mandantentrennung
// bereits vorbereitet, aber noch nicht erzwungen.
model DocumentSourceConfig {
  id             String         @id @default(cuid())
  label          String // Anzeigename, z. B. "Jahresabrechnungen Musterstr. 1"
  source         DocumentSource
  propertyId     String?
  property       Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  audience       Audience       @default(ALLE)
  category       DocumentCategory @default(SONSTIGES)
  // Connector-spezifische Konfiguration (z. B. { folderId: "..." } für Google Drive)
  config         Json
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastSyncAt     DateTime?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])

  @@index([propertyId])
  @@index([source, active])
  @@index([organizationId])
}

model Announcement {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  audience         Audience          @default(ALLE)
  title            String
  body             String
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  acknowledgements Acknowledgement[]

  @@index([propertyId])
  @@index([organizationId])
}

// Lesebestätigung ("zur Kenntnis genommen") für Dokumente und Aushänge
model Acknowledgement {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userId, documentId])
  @@unique([userId, announcementId])
  @@index([documentId])
  @@index([announcementId])
}

// Direktnachrichten zwischen Verwalter und Mieter/Eigentümer
model Conversation {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject        String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  participants   ConversationParticipant[]
  messages       Message[]

  @@index([organizationId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// WEG-Umlaufbeschluss mit digitaler Abstimmung
model Resolution {
  id          String           @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number      Int? // laufende Nummer in der Beschlusssammlung (nach Entscheidung)
  title       String
  description String
  status      ResolutionStatus @default(OFFEN)
  majority    MajorityType     @default(EINFACH) // erforderliche Mehrheit
  deadline    DateTime?
  createdById String
  createdBy   User             @relation("ResolutionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?
  votes       ResolutionVote[]
  agendaItems MeetingAgendaItem[]
  ownerMotions OwnerMotion[]

  @@unique([propertyId, number]) // lückenlose, kollisionsfreie Beschluss-Sammlung (§24 VII WEG); mehrere NULLs erlaubt
  @@index([propertyId])
  @@index([organizationId])
}

// ── Eigentümerversammlung (WEG, „light") ──────────────────────────────────────

enum MeetingStatus {
  GEPLANT
  EINBERUFEN
  DURCHGEFUEHRT
  ABGESAGT
}

enum AgendaItemType {
  INFO
  BESCHLUSS
}

model OwnersMeeting {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title              String
  scheduledAt        DateTime
  location           String?
  // Optionaler Freitext-Link zur Video-Zuschaltung (nur Abdruck in Einladung/
  // Protokoll — KEIN Streaming, keine Live-Abstimmung über das Portal).
  videoLink          String?
  status             MeetingStatus       @default(GEPLANT)
  invitationSentAt   DateTime?
  attendanceNote     String? // Anwesenheits-/Vertretungsvermerk fürs Protokoll
  protocolDocumentId String? // Id des erzeugten Protokoll-Dokuments
  createdById        String
  createdBy          User                @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  agendaItems        MeetingAgendaItem[]
  ownerMotions       OwnerMotion[]

  @@index([organizationId])
  @@index([propertyId])
}

model MeetingAgendaItem {
  id           String         @id @default(cuid())
  meetingId    String
  meeting      OwnersMeeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sortOrder    Int
  title        String
  description  String?
  type         AgendaItemType @default(INFO)
  resolutionId String? // bei type BESCHLUSS: verknüpfter Beschluss
  resolution   Resolution?    @relation(fields: [resolutionId], references: [id], onDelete: SetNull)

  @@index([meetingId])
}

// Aufgabe/Notiz des Verwaltungsbeirats (eigener Beirats-Bereich). Nur für
// Beiratsmitglieder des Objekts und den Verwalter im Scope sichtbar.
model BeiratTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  done           Boolean      @default(false)
  createdById    String
  createdBy      User         @relation("BeiratTaskCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([propertyId])
  @@index([organizationId])
}

model ResolutionVote {
  id           String     @id @default(cuid())
  resolutionId String
  resolution   Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("VoteOwner", fields: [userId], references: [id], onDelete: Cascade)
  choice       VoteChoice
  comment      String?
  // Stellvertretende Stimmabgabe durch den Verwalter (§ 25 WEG, schriftliche
  // Stimme eines Eigentümers, der die App nicht nutzt). castByUserId = Verwalter,
  // der die Stimme eingetragen hat; userId bleibt der abstimmende Eigentümer.
  // Optionaler Nachweis (unterschriebener Stimmzettel als Bild/PDF).
  castByUserId    String?
  castBy          User?   @relation("VoteCastBy", fields: [castByUserId], references: [id], onDelete: SetNull)
  proofStoredName String?
  proofFileName   String?
  proofMimeType   String?
  createdAt    DateTime   @default(now())

  @@unique([resolutionId, userId])
  @@index([castByUserId])
}

// ── Eigentümer-Antrag (Selbstverwaltung, Stufe B) ─────────────────────────────
// Ein Eigentümer reicht einen Beschlussantrag oder das Verlangen einer
// (außerordentlichen) Versammlung ein; der interne Verwalter übernimmt ihn als
// Umlaufbeschluss / Versammlungs-TOP oder lehnt ihn (mit Begründung) ab.
model OwnerMotion {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  submittedById  String
  submittedBy    User           @relation("MotionSubmittedBy", fields: [submittedById], references: [id])
  title          String
  description    String
  type           MotionType     @default(BESCHLUSSANTRAG)
  status         MotionStatus   @default(EINGEREICHT)
  decisionNote   String? // Begründung bei Ablehnung bzw. Hinweis bei Übernahme
  resolutionId   String? // bei Übernahme als Umlaufbeschluss
  resolution     Resolution?    @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  meetingId      String? // bei Übernahme in eine Versammlung
  meeting        OwnersMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  decidedById    String?
  decidedBy      User?          @relation("MotionDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([propertyId])
  @@index([submittedById])
}

// ── Plattform-Rechnung (Betreiber → Kunde) ────────────────────────────────────
// Manuelles Rechnungsmodul des Plattform-Betreibers (B&W) an die Verwaltungen.
// Stripe folgt später; bis dahin werden Rechnungen hier erstellt und der Status
// manuell gepflegt. Nummern sind fortlaufend PRO JAHR (BW-JAHR-NNNN), lückenlos.
enum PlatformInvoiceStatus {
  ENTWURF
  OFFEN
  BEZAHLT
  STORNIERT
}

model PlatformInvoice {
  id             String                @id @default(cuid())
  organizationId String
  // KEIN Cascade: Rechnungen sind Belege und bleiben auch erhalten, wenn eine
  // Organisation gelöscht würde (in der Praxis wird sie nur deaktiviert).
  organization   Organization          @relation(fields: [organizationId], references: [id])
  year           Int
  number         Int // fortlaufend pro Jahr
  title          String
  vatRate        Int                   @default(19) // USt-Satz in Prozent
  status         PlatformInvoiceStatus @default(ENTWURF)
  issuedAt       DateTime? // gesetzt beim Übergang ENTWURF → OFFEN
  dueAt          DateTime?
  paidAt         DateTime? // gesetzt beim Übergang → BEZAHLT
  sentAt         DateTime? // letzter erfolgreicher E-Mail-Versand an den Kunden
  // Mahnwesen: 0 = keine, 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = 2. Mahnung.
  reminderLevel  Int                   @default(0)
  lastReminderAt DateTime?
  createdById    String?
  createdBy      User?                 @relation("PlatformInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  items          PlatformInvoiceItem[]

  @@unique([year, number])
  @@index([organizationId])
  @@index([status])
}

model PlatformInvoiceItem {
  id             String          @id @default(cuid())
  invoiceId      String
  invoice        PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int             @default(1)
  unitPriceCents Int // Einzelpreis netto in Cent
  position       Int             @default(0)

  @@index([invoiceId])
}

// ── Wohnungsübergabe ──────────────────────────────────────────────────────────

enum HandoverType {
  EINZUG
  AUSZUG
  ZWISCHENZUSTAND
}

enum HandoverStatus {
  ENTWURF
  ABGESCHLOSSEN
}

enum RoomType {
  WOHNZIMMER
  SCHLAFZIMMER
  KINDERZIMMER
  KUECHE
  BAD
  GAESTE_WC
  FLUR
  ABSTELLRAUM
  BALKON
  TERRASSE
  KELLER
  GARAGE
  BUERO
  ESSZIMMER
  GARDEROBE
  HAUSWIRTSCHAFTSRAUM
  SONSTIGES
}

model Handover {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             HandoverType    @default(EINZUG)
  status           HandoverStatus  @default(ENTWURF)
  handoverDate     DateTime        @default(now()) // Protokolldatum (Tag der Protokollführung)
  moveDate         DateTime? // Ein- bzw. Auszugsdatum / Stichtag
  unitId           String
  unit             Unit            @relation(fields: [unitId], references: [id])
  // Objektdaten (Schnappschuss zum Übergabezeitpunkt)
  livingArea       Float? // Wohnfläche in m²
  roomCount        Float? // Zimmeranzahl (z. B. 2,5)
  personCount      Int? // Anzahl Personen im Haushalt
  tenantName       String?
  tenantEmail      String?
  tenantPhone      String?
  tenantAddress    String?
  tenantBirthDate  DateTime? // Geburtsdatum Mieter
  tenant2Name      String? // Zweiter Mieter / Mitbewohner
  tenant2BirthDate DateTime?
  tenant2Signature String?
  ownerName        String?
  ownerEmail       String?
  ownerPhone       String?
  managerCompany   String? // Verwaltung / Hausverwaltung
  managerName      String?
  managerEmail     String?
  managerPhone     String?
  keysApartment    Int?
  keysMailbox      Int?
  keysBasement     Int?
  keysGarage       Int?
  keysOther        String?
  parkingSpace     String?
  cellarSpace      String?
  generalNotes     String?
  agreements       String?
  checklist        Json?
  tenantSignature  String?
  managerSignature String?
  pdfStoredName    String?
  createdById      String
  createdBy        User            @relation("HandoverCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  rooms            HandoverRoom[]
  meters           HandoverMeter[]

  @@index([unitId])
  @@index([organizationId])
}

model HandoverRoom {
  id           String          @id @default(cuid())
  handoverId   String
  handover     Handover        @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  name         String
  roomType     RoomType
  sortOrder    Int             @default(0)
  checks       Json? // Strukturierte Prüfpunkte: { key: "ok"|"maengel"|"na", note_key: "…" }
  overallNote  String?
  wallsNote    String?
  ceilingNote  String?
  floorNote    String?
  windowsNote  String?
  doorsNote    String?
  heatingNote  String?
  sanitaryNote String?
  otherNote    String?
  photos       HandoverPhoto[]

  @@index([handoverId])
}

model HandoverPhoto {
  id         String        @id @default(cuid())
  handoverId String
  roomId     String?
  room       HandoverRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  storedName String
  fileName   String
  mimeType   String
  size       Int
  caption    String?
  createdAt  DateTime      @default(now())

  @@index([roomId])
}

model HandoverMeter {
  id              String    @id @default(cuid())
  handoverId      String
  handover        Handover  @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  meterType       MeterType
  meterNumber     String?
  reading         String?
  readingDate     DateTime  @default(now())
  photoStoredName String?
  notes           String?
  sortOrder       Int       @default(0)

  @@index([handoverId])
}

// Web-Push-Abonnements (PWA-Benachrichtigungen)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Interne Notizen – nur für Verwalter sichtbar
model Note {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  body           String
  pinned         Boolean   @default(false)
  authorId     String
  author       User      @relation(fields: [authorId], references: [id])
  // Exactly one target:
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "Note_propertyId_fkey")
  unitId       String?
  unit         Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade, map: "Note_unitId_fkey")
  targetUserId String?
  targetUser   User?     @relation("NotesAboutUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([propertyId])
  @@index([unitId])
  @@index([targetUserId])
  @@index([pinned])
  @@index([organizationId])
}

// DB-backed rate limiting – zählt Versuche pro Schlüssel in einem Zeitfenster.
// Serverless-kompatibel (kein Redis nötig). Abgelaufene Einträge werden
// probabilistisch bereinigt (kein separater Cronjob erforderlich).
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// Unveränderliches Audit-Log für sicherheitsrelevante Aktionen (DSGVO-Löschung,
// Login, Statuswechsel, Freigaben). Einträge werden nie gelöscht – nur SuperAdmin
// darf das Log einsehen.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

// ── WEG-Finanzfundament: Kostenarten, Konten, Buchungen ─────────────────────

// Kostenart einer WEG (z. B. Hausmeister, Gebäudeversicherung). Vorbefüllbar aus
// dem WEG-Standardkatalog (src/lib/weg/cost-catalog.ts), danach frei editierbar.
model CostType {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name              String
  category          CostCategory    @default(BETRIEBSKOSTEN)
  distributionKey   DistributionKey @default(MEA)
  laborShareType    LaborShareType  @default(KEINE) // §35a EStG
  // Erfahrungswert für den Lohn-/Fahrt-/Maschinenkostenanteil dieser Kostenart
  // in Prozent (§ 35a EStG). Greift nur, wenn an der einzelnen Buchung nichts
  // erfasst ist — die Rechnung geht immer vor. null = keine Vorbelegung, dann
  // wird der Betrag als „Lohnanteil nicht erfasst" ausgewiesen statt geschätzt.
  laborSharePercent Int?
  // Heiz-/Warmwasserkosten im Sinne der HeizkostenV. Für sie gilt die
  // Zwangsaufteilung 50–70 % Verbrauch / Rest Fläche (§§ 7, 8 HeizkostenV);
  // eine Verteilung zu 100 % nach Verbrauch wäre formell fehlerhaft und gäbe
  // jedem Eigentümer ein Kürzungsrecht von 15 % (§ 12 Abs. 1 HeizkostenV).
  heatingCost       Boolean         @default(false)
  // Tatsächlich angewandter Verbrauchsanteil (50–70). Wird beim Verteilen
  // gesetzt und in die Abrechnung übernommen: Ohne ihn steht im Dokument nur
  // „Verbrauch" — das liest sich wie eine Verteilung zu 100 % nach Verbrauch
  // und damit wie ein Verstoß gegen §§ 7, 8 HeizkostenV, obwohl korrekt
  // gerechnet wurde.
  heatingConsumptionPercent Int?
  // Bauleistung im Sinne des § 48 Abs. 1 Satz 3 EStG: Herstellung,
  // Instandsetzung, Instandhaltung, Änderung oder Beseitigung von Bauwerken.
  //
  // Die Unterscheidung ist nicht kosmetisch. Ohne sie warnte das Programm auch
  // bei der Treppenhausreinigung und beim Gartendienst — beides ist **keine**
  // Bauleistung — und die Warnung wäre nach dem dritten Fehlalarm wertlos.
  constructionWork  Boolean         @default(false)
  recoverableBetrKV Boolean         @default(false) // umlagefähig nach BetrKV (Mieter)
  active            Boolean         @default(true)
  orderIndex        Int             @default(0)
  createdAt         DateTime        @default(now())
  bookings          Booking[]
  planItems         EconomicPlanItem[]
  statementUnitAmounts StatementUnitAmount[]

  @@index([propertyId])
}

// Geldkonto der Gemeinschaft. Erhaltungsrücklage (RUECKLAGE) strikt getrennt
// vom laufenden Girokonto ausweisen (§ 19 Abs. 2 Nr. 4 WEG).
model LedgerAccount {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId          String
  property            Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name                String
  kind                LedgerAccountKind @default(GIRO)
  iban                String?
  openingBalanceCents Int               @default(0) // Anfangsbestand in Cent
  openingBalanceDate  DateTime? // Stichtag des Anfangsbestands
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  bookings            Booking[]
  importBatches       BankImportBatch[]
  statementChecks     StatementAccountCheck[]

  @@index([propertyId])
}

// Einnahme/Ausgabe/Umbuchung. Betrag IMMER positiv (Integer-Cent), die Richtung
// steckt in kind. Kontostand = Anfangsbestand + Σ EINNAHME − Σ AUSGABE
// (UMBUCHUNGen zählen je Konto als Einnahme bzw. Ausgabe der Gegenseite,
// verbunden über transferGroupId).
model Booking {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  accountId       String
  account         LedgerAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costTypeId      String?
  costType        CostType?        @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  // Zahlungszuordnung: Hausgeld-Eingang einer Einheit zugeordnet (offene Posten)
  unitId          String?
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // Wer bezahlt wurde — als Verknüpfung, nicht als getippter Name.
  //
  // `counterparty` bleibt daneben bestehen und ist weiterhin der Normalfall:
  // Beim Bankimport liefert die Bank Text, und die meisten Zahlungen gehen an
  // niemanden aus dem Adressbuch. Die Verknüpfung ist deshalb optional.
  //
  // Nötig wurde sie für § 48 EStG: Die 5.000-€-Grenze gilt **je Leistendem und
  // Kalenderjahr**. Über einen Freitext lässt sich das nicht summieren — „Meier
  // GmbH", „Meier Gmbh" und „Fa. Meier" wären drei Handwerker.
  craftsmanId     String?
  craftsman       Craftsman?       @relation(fields: [craftsmanId], references: [id], onDelete: SetNull)
  kind            BookingKind
  bookingDate     DateTime
  valueDate       DateTime? // Wertstellung (aus Bankimport)
  amountCents     Int // immer positiv; Richtung über kind
  // §35a EStG: der in der Rechnung ausgewiesene Lohn-, Fahrt- und
  // Maschinenkostenanteil. NUR dieser Teil ist begünstigt — Material nicht.
  // null = nicht erfasst (nicht: null Euro); dann greift der Erfahrungswert der
  // Kostenart, und fehlt auch der, wird der Betrag als Lücke ausgewiesen.
  laborShareCents Int?
  text            String
  counterparty    String? // Zahlungspartner
  reference       String? // Verwendungszweck
  // Bankimport / Duplikaterkennung
  importBatchId   String?
  importBatch     BankImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  dedupeHash      String? // Hash aus Konto+Datum+Betrag+Verwendungszweck
  // Umbuchung Giro<->Rücklage: zwei Gegenbuchungen (je Konto eine) mit
  // gemeinsamer transferGroupId; beide kind=UMBUCHUNG, Richtung über transferOut.
  transferGroupId String?
  transferOut     Boolean? // nur bei UMBUCHUNG: true = Geld verlässt dieses Konto
  // Storno: Buchungen werden nie geändert oder gelöscht, sondern durch eine
  // Gegenbuchung neutralisiert. Diese zeigt über reversalOfId auf das Original;
  // @unique stellt sicher, dass jede Buchung höchstens einmal storniert wird.
  reversalOfId    String?          @unique
  reversalOf      Booking?         @relation("BookingReversal", fields: [reversalOfId], references: [id], onDelete: Cascade)
  reversedBy      Booking?         @relation("BookingReversal")
  // Auf welche Forderungen diese Zahlung angerechnet wurde (§§ 366, 367 BGB).
  allocations     PaymentAllocation[]
  // Beleg (gleiche Storage-Konvention wie Handover: storedName/fileName/mimeType)
  belegStoredName String?
  belegFileName   String?
  belegMimeType   String?
  createdById     String
  createdBy       User             @relation("BookingCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())

  @@unique([accountId, dedupeHash]) // verhindert Doppelimport (NULL = manuell, mehrfach erlaubt)
  @@index([propertyId])
  @@index([accountId])
  @@index([costTypeId])
  @@index([importBatchId])
  @@index([unitId])
  @@index([craftsmanId])
}

// Ein CSV-Import-Vorgang (für Anzeige + Rückgängig)
model BankImportBatch {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName       String
  source         String        @default("CSV") // CSV | CAMT053 | MT940 (später)
  rowsTotal      Int
  rowsImported   Int
  rowsSkipped    Int
  createdById    String
  createdBy      User          @relation("BankImportCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  bookings       Booking[]

  @@index([accountId])
  @@index([propertyId])
}

// ── WEG-Finanzen Stufe 2: Wirtschaftsplan & Hausgeld-Sollstellungen ──────────

// Wirtschaftsplan (§ 28 Abs. 1 WEG): jährliche Vorschüsse (Hausgeld) und
// Rücklagenzuführung. Nach Beschluss unveränderlich; der Beschluss erzeugt die
// monatlichen Sollstellungen je Einheit.
model EconomicPlan {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  year           Int // Wirtschaftsjahr, das in diesem Kalenderjahr beginnt
  status         PlanStatus         @default(ENTWURF)
  resolvedAt     DateTime? // Datum des Beschlusses (Versammlung/Umlauf)
  // Geltungszeitraum. Der Plan ist NICHT starr an sein Wirtschaftsjahr
  // gebunden: Nach § 28 Abs. 1 Satz 2 WEG gilt ein beschlossener Plan fort,
  // bis ein neuer beschlossen ist — sonst schuldete im Januar niemand Hausgeld,
  // nur weil die Versammlung erst im April tagt. Umgekehrt kann ein geänderter
  // Plan unterjährig beginnen.
  //
  // `validFrom` wird mit dem Beschluss gesetzt (null = noch nicht beschlossen),
  // `validUntil` erst, wenn ein Nachfolgeplan beschlossen wird (null = gilt fort).
  // Beide Grenzen sind Tagesdaten; `validUntil` ist exklusiv.
  validFrom      DateTime?
  validUntil     DateTime?
  resolutionNote String? // Verweis, z. B. "ETV 12.03.2026, TOP 4"
  createdById    String
  createdBy      User               @relation("EconomicPlanCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  items          EconomicPlanItem[]
  duePostings    DuePosting[]
  // Prüfvermerk des Verwaltungsbeirats (§ 29 III WEG)
  beiratReviewStatus BeiratReviewStatus?
  beiratReviewNote   String?
  beiratReviewById   String?
  beiratReviewBy     User?              @relation("EconomicPlanBeiratReview", fields: [beiratReviewById], references: [id], onDelete: SetNull)
  beiratReviewedAt   DateTime?

  // Kein @@unique([propertyId, year]) mehr: Ein unterjährig geänderter
  // Wirtschaftsplan ist ein zweiter Plan desselben Jahres. Die Abgrenzung
  // leistet der Geltungszeitraum, nicht die Eindeutigkeit des Jahres.
  @@index([propertyId, year])
  @@index([propertyId])
}

// Planposition je Kostenart (Jahres-Planwert in Cent). previousActualCents hält
// den Vorjahres-Istwert zum Vergleich fest (Stand bei Plan-Erstellung).
model EconomicPlanItem {
  id                  String       @id @default(cuid())
  planId              String
  plan                EconomicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  costTypeId          String
  costType            CostType     @relation(fields: [costTypeId], references: [id], onDelete: Cascade)
  amountCents         Int // Jahres-Planwert (immer positiv)
  previousActualCents Int? // Istwert des Vorjahres (informativ)

  @@unique([planId, costTypeId])
  @@index([costTypeId])
}

// Sollstellung: monatliche Hausgeld-Forderung je Einheit aus dem beschlossenen
// Wirtschaftsplan (später auch Sonderumlagen). Offene Posten = Σ fällige
// Sollstellungen − Σ zugeordnete Zahlungseingänge (Booking.unitId).
model DuePosting {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  planId         String?
  plan           EconomicPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  sonderumlageId String?
  sonderumlage   Sonderumlage? @relation(fields: [sonderumlageId], references: [id], onDelete: Cascade)
  dueDate        DateTime // Fälligkeit (1. des Monats bzw. Fälligkeit der Sonderumlage)
  periodYear     Int
  periodMonth    Int // 1–12 (Kalendermonat)
  amountCents    Int
  source         String        @default("WIRTSCHAFTSPLAN") // WIRTSCHAFTSPLAN | SONDERUMLAGE
  createdAt      DateTime      @default(now())
  // Zahlungen, die auf diese Forderung angerechnet wurden.
  allocations    PaymentAllocation[]

  @@unique([planId, unitId, periodYear, periodMonth])
  @@index([propertyId])
  @@index([sonderumlageId])
  @@index([unitId])
}

// Anrechnung einer Zahlung auf eine bestimmte Forderung (§§ 366, 367 BGB).
//
// Vorher ordnete `Booking.unitId` eine Zahlung pauschal einer Einheit zu, und
// der Rückstand war „alle Sollstellungen minus alle Einnahmen dieser Einheit".
// Das rechnet vieles falsch: Die Zahlung einer Sonderumlage tilgte
// Hausgeldrückstände, eine Vorauszahlung verschleierte einen Rückstand, und
// eine Sammelüberweisung für zwei Einheiten ließ sich gar nicht aufteilen.
// Nach außen stand am Ende ein falscher Betrag in der Mahnung.
//
// `Booking.unitId` bleibt als Vorfilter bestehen — es beantwortet „von wem kam
// das Geld", diese Tabelle „worauf wurde es angerechnet".
model PaymentAllocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  duePostingId   String
  duePosting     DuePosting   @relation(fields: [duePostingId], references: [id], onDelete: Cascade)
  amountCents    Int // Teilbetrag; Σ je Buchung ≤ Buchungsbetrag
  createdById    String
  createdBy      User         @relation("PaymentAllocationCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  // Eine Zahlung wird je Forderung genau einmal angerechnet; Teilbeträge
  // stehen im Betrag, nicht in mehreren Zeilen.
  @@unique([bookingId, duePostingId])
  @@index([duePostingId])
}

// ── WEG-Finanzen Stufe 3: Eigentümerschaft je Einheit & Jahresabrechnung ─────

// Tagesgenaue Eigentümerschaft einer Einheit (Eigentümerwechsel!). Ergänzt das
// objektweite Ownership (Stimmrecht) um die einheitsbezogene Zuordnung für die
// zeitanteilige Abrechnung. sharePercent für Miteigentümer derselben Einheit.
model UnitOwnership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  validFrom      DateTime
  validTo        DateTime? // null = bis heute
  sharePercent   Float        @default(100) // Anteil bei Miteigentum derselben Einheit
  createdAt      DateTime     @default(now())

  @@index([unitId])
  @@index([userId])
}

// Erledigt-Vermerk für die Einrichtungsschritte einer selbstverwalteten WEG,
// die AUSSERHALB des Systems stattfinden — Unterlagen vom alten Verwalter,
// WEG-Bankkonto, Verwalterbestellung. Alle übrigen Schritte der Einrichtung
// leitet `weg/setup-status.ts` aus den Daten selbst ab und braucht hier nichts:
// Ein abgeleiteter Zustand kann nicht veralten, ein gespeichertes Häkchen schon.
model WegSetupStep {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Schlüssel aus MANUAL_SETUP_STEPS (weg/setup-status.ts).
  key        String
  doneAt     DateTime @default(now())
  doneById   String?
  doneBy     User?    @relation("WegSetupStepDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  // Ein Vermerk je Schritt und Objekt; das Abhaken ist damit idempotent.
  @@unique([propertyId, key])
}

// Jahresabrechnung (§ 28 Abs. 2 WEG). ENTWURF wird live aus der Buchhaltung
// gerechnet; FERTIG friert das Ergebnis als Snapshot ein (revisionssicher).
model AnnualStatement {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  year           Int // Wirtschaftsjahr, das in diesem Kalenderjahr beginnt
  status         StatementStatus         @default(ENTWURF)
  finalizedAt    DateTime?
  snapshot       Json? // eingefrorenes Ergebnis bei FERTIG
  createdById    String
  createdBy      User                    @relation("StatementCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime                @default(now())
  unitAmounts    StatementUnitAmount[]
  accountChecks  StatementAccountCheck[]
  // Prüfvermerk des Verwaltungsbeirats (§ 29 III WEG)
  beiratReviewStatus BeiratReviewStatus?
  beiratReviewNote   String?
  beiratReviewById   String?
  beiratReviewBy     User?                   @relation("StatementBeiratReview", fields: [beiratReviewById], references: [id], onDelete: SetNull)
  beiratReviewedAt   DateTime?

  @@unique([propertyId, year])
  @@index([propertyId])
}

// Manuelle Verteilung je Einheit für Kostenarten mit Schlüssel VERBRAUCH /
// INDIVIDUELL / FESTBETRAG (z. B. Heizkosten aus der Messdienst-Abrechnung).
// Plausibilität: Σ je Kostenart muss dem Gesamtbetrag der Kostenart entsprechen.
model StatementUnitAmount {
  id          String          @id @default(cuid())
  statementId String
  statement   AnnualStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  costTypeId  String
  costType    CostType        @relation(fields: [costTypeId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amountCents Int

  @@unique([statementId, costTypeId, unitId])
  @@index([unitId])
  @@index([costTypeId])
}

// Harte Plausibilitätsprüfung der Gesamtabrechnung: je Konto der tatsächliche
// Endbestand laut Kontoauszug. FERTIG nur, wenn rechnerischer Endbestand ==
// gemeldeter Endbestand für alle Konten (häufigster Anfechtungsgrund).
model StatementAccountCheck {
  id                String          @id @default(cuid())
  statementId       String
  statement         AnnualStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  accountId         String
  account           LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reportedEndCents  Int // Endbestand laut Kontoauszug

  @@unique([statementId, accountId])
  @@index([accountId])
}

// ── WEG-Mahnwesen: Hausgeld-Zahlungserinnerung & Mahnungen ───────────────────
// Stufen wie im Plattform-Mahnwesen (lib/dunning.ts): 1 = Zahlungserinnerung,
// 2 = 1. Mahnung, 3 = 2. Mahnung. Keine automatischen Gebühren. Rückstand und
// Empfänger werden beim Erstellen eingefroren (Snapshot) — das PDF bleibt
// reproduzierbar, auch wenn später Zahlungen eingehen.
model HausgeldMahnung {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  level           Int // 1–3, siehe lib/dunning.ts
  arrearsCents    Int // Rückstand zum Erstellzeitpunkt
  paymentDeadline DateTime // Zahlungsziel
  recipientName   String // Empfänger-Snapshot (aktuelle Eigentümer der Einheit)
  recipientAddress String? // Snapshot "Straße\nPLZ Ort" (falls hinterlegt)
  // Anrede-Snapshot für die Briefanrede. Wie Name und Anschrift eingefroren:
  // Das Schreiben muss auch später zeigen, wie es verschickt wurde. Bei
  // mehreren Eigentümern bleiben beide leer — dann grüßt der Brief allgemein.
  recipientSalutation String? // "Herr" oder "Frau"
  recipientLastName   String?
  sentAt          DateTime? // "als versendet markiert" (Fristen-Nachweis)
  createdById     String
  createdBy       User         @relation("MahnungCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())

  @@index([unitId])
  @@index([propertyId])
}

// ── WEG-Sonderumlage (§ 28 WEG i. V. m. Beschluss) ───────────────────────────
// Einmalige Umlage (z. B. für eine größere Erhaltungsmaßnahme), beschlossen und
// nach einem Schlüssel auf die Einheiten verteilt. Erzeugt Sollstellungen
// (DuePosting, source=SONDERUMLAGE), die in die offenen Posten und das
// Mahnwesen einfließen. Löschen entfernt die zugehörigen Sollstellungen.
model Sonderumlage {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title            String
  purpose          String? // Zweck/Verwendung (z. B. "Dachsanierung")
  totalAmountCents Int
  distributionKey  DistributionKey @default(MEA)
  dueDate          DateTime
  resolutionNote   String? // Beschluss-Verweis (z. B. "ETV 12.03.2026, TOP 5")
  createdById      String
  createdBy        User            @relation("SonderumlageCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  duePostings      DuePosting[]

  @@index([propertyId])
}

// ── WEG-Erhaltungsplanung (§ 19 Abs. 2 Nr. 2 WEG) ────────────────────────────
// Langfristige Maßnahmenliste je Objekt (Titel, Gewerk, Zieljahr, Kosten-
// schätzung). Aus den Maßnahmen wird der Rücklagenbedarf hergeleitet und dem
// aktuellen Rücklagenstand (aus der Buchhaltung) gegenübergestellt.
model MaintenanceMeasure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title          String
  trade          String? // Gewerk (Freitext, z. B. "Dach", "Fassade", "Heizung")
  targetYear     Int // geplantes Umsetzungsjahr
  estimatedCents Int // Kostenschätzung (immer positiv)
  note           String?
  done           Boolean      @default(false) // erledigt → nicht mehr im Bedarf
  createdById    String
  createdBy      User         @relation("MaintenanceMeasureCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([propertyId])
  @@index([propertyId, done])
}

// ── Integrationen (Phase 3, Adapter-Prinzip) ─────────────────────────────────
// Optionale API-Zugänge je Bereich (Open Banking, Messdienst …). Zero-Key:
// ohne Eintrag zeigt die UI automatisch den manuellen Weg. Secrets werden
// anwendungsseitig verschlüsselt abgelegt (src/lib/crypto.ts), nie im Klartext.
model IntegrationSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area           String // BANKING | MESSDIENST | …
  provider       String? // z. B. "finapi", "gocardless", "ista"
  enabled        Boolean      @default(false)
  secretEnc      String? // verschlüsselter API-Key (AES-256-GCM)
  configJson     Json? // weitere, nicht geheime Konfiguration
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, area])
  @@index([organizationId])
}

// ── SEPA-Lastschrift-Mandat (Hausgeldeinzug, M-F) ────────────────────────────
// Ein Mandat je Einheit: Ermächtigung des Eigentümers zum Einzug des Hausgelds.
// Der pain.008-Export erzeugt daraus eine XML-Datei zum Selbst-Upload ins
// Online-Banking (Zero-Key, keine externe API).
enum SepaSequence {
  FRST // erstmalige Lastschrift
  RCUR // wiederkehrend
  OOFF // einmalig
}

model SepaMandate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  mandateRef     String // eindeutige Mandatsreferenz
  debtorName     String // Kontoinhaber (Zahlungspflichtiger)
  iban           String
  bic            String?
  signedDate     DateTime // Datum der Mandatsunterschrift
  sequence       SepaSequence @default(FRST)
  active         Boolean      @default(true)
  createdById    String
  createdBy      User         @relation("SepaMandateCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([propertyId, unitId])
  @@index([propertyId])
}

// ── CO2-Kostenaufteilung (CO2KostAufG, M-I) ──────────────────────────────────
// Erfasst je Objekt und Jahr den CO2-Kostenanteil und die Gesamtemissionen aus
// der Brennstoffrechnung. Daraus wird nach dem 10-Stufen-Modell (§ 5 CO2KostAufG)
// der Vermieter-/Mieteranteil hergeleitet — Datenbasis für vermietende Eigentümer.
model Co2Allocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  year           Int
  totalCo2Cents  Int // CO2-Kostenanteil der Heizkosten (aus der Rechnung)
  emissionsKg    Float // Gesamtemissionen kg CO2 (aus der Rechnung)
  note           String?
  createdById    String
  createdBy      User         @relation("Co2AllocationCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([propertyId, year])
  @@index([propertyId])
}

// ── Handwerker-Netzwerk: digitale Rechnung (M-L) ─────────────────────────────
// Schließt den digitalen Auftrags-Relay ab: der Handwerker reicht über den
// Magic-Link seine Rechnung (Betrag + Datei) ein; der Verwalter prüft und
// akzeptiert sie (dann werden die Kosten am Vorgang übernommen).
enum InvoiceStatus {
  EINGEREICHT
  AKZEPTIERT
  ABGELEHNT
}

model CraftsmanInvoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId       String        @unique // eine Rechnung je Vorgang (Neueinreichung ersetzt)
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  craftsmanId    String
  craftsman      Craftsman     @relation(fields: [craftsmanId], references: [id], onDelete: Cascade)
  amountCents    Int
  invoiceNumber  String?
  invoiceDate    DateTime?
  note           String?
  // hochgeladene Rechnungsdatei (PDF/Bild)
  storedName     String
  fileName       String
  mimeType       String
  size           Int
  status         InvoiceStatus @default(EINGEREICHT)
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([craftsmanId])
}
