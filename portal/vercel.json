{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run pruefung && (prisma db execute --file prisma/repair_failed_migration.sql || true) && prisma migrate deploy && next build",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/pruefpflichten",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/basiszinssatz",
      "schedule": "0 5 2 * *"
    }
  ]
}
